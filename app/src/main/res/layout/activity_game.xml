<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Ikona i nazwa Gracza 1 -->
    <ImageView
        android:id="@+id/player1_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/k1" />

    <TextView
        android:id="@+id/player1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gracz 1"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/player1_icon"
        app:layout_constraintStart_toStartOf="@id/player1_icon"
        android:layout_marginTop="8dp" />

    <!-- Ikona i nazwa Gracza 2 -->
    <ImageView
        android:id="@+id/player2_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/o1" />

    <TextView
        android:id="@+id/player2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gracz 2"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/player2_icon"
        app:layout_constraintEnd_toEndOf="@id/player2_icon"
        android:layout_marginTop="8dp" />

    <!-- Wynik gry -->
    <TextView
        android:id="@+id/score_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 | 0"
        android:textSize="50sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Informacja o aktualnym graczu -->
    <TextView
        android:id="@+id/current_turn_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ruch: Gracz 1"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/score_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Siatka gry -->
    <GridLayout
        android:id="@+id/grid_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rowCount="3"
        android:columnCount="3"
        android:background="#800080"

        app:layout_constraintTop_toBottomOf="@id/current_turn_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp">


    <!-- Puste pola planszy -->
        <ImageView
            android:id="@+id/image_00"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />


        <ImageView
            android:id="@+id/image_01"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_02"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_10"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_11"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_12"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_20"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_21"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />

        <ImageView
            android:id="@+id/image_22"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_margin="4dp"
            android:background="#FFFFFF"
            android:scaleType="centerInside" />
    </GridLayout>


    <!-- Przycisk Wyjdź -->
    <Button
        android:id="@+id/button_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wyjdź"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="40dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
