<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.example.kolko_krzyzyk.MainActivity"
    tools:showIn="@layout/activity_main">


    <ImageView
        android:id="@+id/imageView"
        android:layout_width="147dp"
        android:layout_height="99dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/description"
        android:src="@drawable/logo"
        android:maxLength="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/editText2"
        android:layout_width="137dp"
        android:layout_height="44dp"
        android:hint="@string/etykietaGracz2"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="@+id/button1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.934"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.752" />

    <ImageView
        android:id="@+id/player2_icon"
        android:layout_width="41dp"
        android:layout_height="39dp"
        android:layout_marginTop="208dp"
        android:layout_marginEnd="116dp"
        android:contentDescription="Ikona gracza 2"
        android:src="@drawable/o1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/player2_dropdown"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:src="@drawable/set"
        app:layout_constraintEnd_toEndOf="@id/player2_icon"
        app:layout_constraintHorizontal_bias="0.714"
        app:layout_constraintStart_toStartOf="@id/player2_icon"
        app:layout_constraintTop_toBottomOf="@id/player2_icon" />

    <EditText
        android:id="@+id/editText1"
        android:layout_width="137dp"
        android:layout_height="44dp"
        android:hint="@string/etykietaGracz1"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="@+id/button1"
        app:layout_constraintEnd_toEndOf="@+id/button1"
        app:layout_constraintHorizontal_bias="0.279"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.752" />

    <ImageButton
        android:id="@+id/player1_dropdown"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        android:src="@drawable/set"
        app:layout_constraintEnd_toEndOf="@id/player1_icon"
        app:layout_constraintHorizontal_bias="0.761"
        app:layout_constraintStart_toStartOf="@id/player1_icon"
        app:layout_constraintTop_toBottomOf="@id/player1_icon" />

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="160dp"
        android:layout_marginTop="376dp"
        android:maxLength="10"
        android:text="@string/etykietaPrzycisk"
        android:backgroundTint="#00FF00"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/player1_icon"
        android:layout_width="41dp"
        android:layout_height="39dp"
        android:layout_marginStart="116dp"
        android:layout_marginTop="208dp"
        android:contentDescription="Ikona gracza 1"
        android:src="@drawable/k1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:onClick="exitApp"
        android:text="Wyłącz"
        android:backgroundTint="#FF0000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button1" />


</androidx.constraintlayout.widget.ConstraintLayout>